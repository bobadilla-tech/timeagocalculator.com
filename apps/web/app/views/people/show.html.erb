<%= render "shared/structured_data", schema: @schema %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">How Old Is <%= @name %>?</h1>
  <p class="text-slate-500 mb-8">As of <%= Date.today.strftime("%B %-d, %Y") %></p>

  <% if @result %>
    <%= render "shared/result_card" do %>
      <p class="text-lg font-semibold text-slate-700 mb-6">
        <%= @name %> is <span class="text-blue-600 text-2xl font-bold"><%= @result.years %></span> years old.
      </p>

      <div class="grid grid-cols-3 gap-4 mb-6">
        <% [
          [ @result.years,  "Years"  ],
          [ @result.months, "Months" ],
          [ @result.days,   "Days"   ]
        ].each do |value, label| %>
          <div class="text-center bg-slate-50 rounded-xl p-4">
            <div class="text-2xl font-bold text-blue-700"><%= number_with_delimiter(value) %></div>
            <div class="text-xs text-slate-500 mt-1"><%= label %></div>
          </div>
        <% end %>
      </div>

      <p class="text-sm text-slate-500">
        Born <%= @result.birthdate.strftime("%B %-d, %Y") %>.
        Next birthday in <span class="font-semibold text-slate-700"><%= @result.next_birthday_in_days %> days</span>.
      </p>
    <% end %>
  <% end %>

  <div class="mt-8">
    <%= link_to "Calculate your own age →", age_calculator_path, class: "text-blue-600 hover:underline font-medium" %>
  </div>
</div>
