<div class="max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <h1 class="text-2xl font-bold text-slate-900 flex-1">Business Days Calculation</h1>
    <% if @calculation.owned_by?(Current.user) %>
      <%= button_to "Delete", destroy_business_days_calculation_path(@calculation.token),
            method: :delete,
            form: { data: { turbo_confirm: "Delete this calculation?" } },
            class: "text-xs bg-red-100 hover:bg-red-200 text-red-700 font-medium px-3 py-1.5 rounded-lg cursor-pointer" %>
    <% end %>
  </div>

  <%= render "shared/result_card" do %>
    <% if @result.is_a?(DateCalculations::BusinessDaysCalculator::BetweenResult) %>
      <p class="text-lg font-semibold text-slate-700 mb-6">
        Between <span class="text-blue-600"><%= @result.from.strftime("%B %-d, %Y") %></span>
        and <span class="text-blue-600"><%= @result.to.strftime("%B %-d, %Y") %></span>
        <% if @country_name %>
          <span class="text-sm font-normal text-slate-500">· <%= @country_name %></span>
        <% end %>
      </p>
      <div class="grid grid-cols-2 gap-4">
        <div class="text-center bg-slate-50 rounded-xl p-5">
          <div class="text-3xl font-bold text-blue-700"><%= number_with_delimiter(@result.business_days) %></div>
          <div class="text-sm text-slate-500 mt-1">Business Days</div>
          <% if @calculation.country_code.present? %>
            <div class="text-xs text-slate-400 mt-0.5">holidays excluded</div>
          <% end %>
        </div>
        <div class="text-center bg-slate-50 rounded-xl p-5">
          <div class="text-3xl font-bold text-slate-700"><%= number_with_delimiter(@result.total_days) %></div>
          <div class="text-sm text-slate-500 mt-1">Total Calendar Days</div>
        </div>
      </div>
    <% else %>
      <%
        direction_label = @result.direction == :forward ? "after" : "before"
      %>
      <p class="text-lg font-semibold text-slate-700 mb-6">
        <span class="text-blue-600"><%= @result.business_days %></span>
        business <%= "day".pluralize(@result.business_days) %>
        <%= direction_label %>
        <span class="text-blue-600"><%= @result.start_date.strftime("%B %-d, %Y") %></span>
        <% if @country_name %>
          <span class="text-sm font-normal text-slate-500">· <%= @country_name %></span>
        <% end %>
      </p>
      <div class="text-center bg-slate-50 rounded-xl p-6">
        <div class="text-3xl font-bold text-blue-700"><%= @result.result_date.strftime("%B %-d, %Y") %></div>
        <div class="text-sm text-slate-500 mt-1"><%= @result.result_date.strftime("%A") %></div>
      </div>
    <% end %>
  <% end %>

  <%# Share section %>
  <div class="mt-6 bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
    <p class="text-sm font-medium text-slate-700 mb-2">Share this result</p>
    <div class="flex gap-2">
      <input type="text" readonly value="<%= business_days_calculation_url(@calculation.token) %>"
             class="flex-1 text-sm border border-slate-300 rounded-lg px-3 py-2 text-slate-600 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
             onclick="this.select()" />
      <button type="button"
              onclick="navigator.clipboard.writeText(this.previousElementSibling.value).then(() => this.textContent = 'Copied!')"
              class="text-sm bg-slate-900 hover:bg-slate-700 text-white font-medium px-4 py-2 rounded-lg transition-colors cursor-pointer whitespace-nowrap">
        Copy link
      </button>
    </div>
  </div>

  <% unless Current.user %>
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-2xl p-5 flex items-start gap-3">
      <div class="text-blue-500 text-xl shrink-0">💼</div>
      <div>
        <p class="text-sm font-semibold text-blue-900 mb-0.5">Save and manage your calculations</p>
        <p class="text-sm text-blue-700 mb-3">
          Create a free account to keep a history of all your calculations, add notes and labels, and access them from your dashboard anytime.
        </p>
        <div class="flex gap-2">
          <%= link_to "Create a free account", new_registration_path,
                class: "text-sm bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors" %>
          <%= link_to "Sign in", new_session_path,
                class: "text-sm text-blue-600 hover:underline font-medium py-2" %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-6 flex gap-3">
    <%= link_to "Calculate another →", business_days_calculator_path,
          class: "text-blue-600 hover:underline font-medium text-sm" %>
    <% if Current.user %>
      <%= link_to "My calculations", dashboard_path(tab: "calculations"),
            class: "text-slate-500 hover:text-slate-700 text-sm" %>
    <% end %>
  </div>
</div>
