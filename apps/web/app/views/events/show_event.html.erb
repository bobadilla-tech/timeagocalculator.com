<%= render "shared/structured_data", schema: @schema %>

<div class="max-w-2xl mx-auto">
  <nav class="text-sm text-slate-400 mb-6">
    <%= link_to "Home", root_path, class: "hover:text-blue-600" %> /
    <%= link_to "Event Countdowns", events_path, class: "hover:text-blue-600" %> /
    <span class="text-slate-600"><%= @event.title %></span>
  </nav>

  <%# Hero image %>
  <% if @event.image_url.present? %>
    <div class="mb-6 rounded-2xl overflow-hidden shadow-sm">
      <img src="<%= @event.image_url %>" alt="<%= @event.title %>" class="w-full h-56 object-cover">
    </div>
  <% end %>

  <% if @event.upcoming? %>
    <%# ── UPCOMING EVENT ── %>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">How Long Until <%= @event.title %>?</h1>
    <p class="text-slate-500 mb-8">
      <%= @event.starts_at.strftime("%A, %B %-d, %Y") %>
      <% if @event.category.present? %>
        &bull; <%= @event.category.titleize %>
      <% end %>
    </p>

    <%= render "shared/result_card" do %>
      <% days  = @event.days_until %>
      <% weeks = @event.weeks_until %>
      <p class="text-lg font-semibold text-slate-700 mb-6">
        <% if days == 0 %>
          <span class="text-blue-600"><%= @event.title %> is today!</span>
        <% else %>
          <%= @event.title %> is in
          <span class="text-blue-600"><%= days %> <%= "day".pluralize(days) %></span>.
        <% end %>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <% [
          [ days,  "Days"  ],
          [ weeks, "Weeks" ],
          [ (@event.starts_at.to_date - Date.current).to_i / 30, "Months" ]
        ].each do |value, label| %>
          <div class="text-center bg-slate-50 rounded-xl p-4">
            <div class="text-2xl font-bold text-blue-700"><%= number_with_delimiter([value.to_i, 0].max) %></div>
            <div class="text-xs text-slate-500 mt-1"><%= label %></div>
          </div>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <%# ── PAST EVENT ── %>
    <h1 class="text-3xl font-bold text-slate-900 mb-2">How Long Ago Was <%= @event.title %>?</h1>
    <p class="text-slate-500 mb-8">
      <%= @event.starts_at.strftime("%A, %B %-d, %Y") %>
      <% if @event.category.present? %>
        &bull; <%= @event.category.titleize %>
      <% end %>
    </p>

    <% if @result %>
      <%= render "shared/result_card" do %>
        <p class="text-lg font-semibold text-slate-700 mb-6">
          <%= @event.title %> was
          <span class="text-blue-600"><%= @result.human %></span>.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <% [
            [ @result.years,      "Years"      ],
            [ @result.months,     "Months"     ],
            [ @result.days,       "Days"       ],
            [ @result.total_days, "Total Days" ]
          ].each do |value, label| %>
            <div class="text-center bg-slate-50 rounded-xl p-4">
              <div class="text-2xl font-bold text-blue-700"><%= number_with_delimiter(value) %></div>
              <div class="text-xs text-slate-500 mt-1"><%= label %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# Description %>
  <% if @event.description.present? %>
    <div class="mt-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <h2 class="text-lg font-semibold text-slate-800 mb-3">About <%= @event.title %></h2>
      <p class="text-slate-600"><%= @event.description %></p>
    </div>
  <% end %>

  <%# Body %>
  <% if @event.body.present? %>
    <div class="mt-6 bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
      <% @event.body.split("\n\n").each do |para| %>
        <p class="text-slate-600 leading-relaxed"><%= para %></p>
      <% end %>
    </div>
  <% end %>

  <%# FAQ %>
  <% if @faq.present? %>
    <div class="mt-8 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <h2 class="text-lg font-semibold text-slate-800 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4" itemscope itemtype="https://schema.org/FAQPage">
        <% @faq.each do |item| %>
          <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <h3 class="font-semibold text-slate-800" itemprop="name"><%= item[:q] %></h3>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p class="text-slate-600 mt-1 text-sm" itemprop="text"><%= item[:a] %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flex gap-4">
    <%= link_to "← All events", events_path, class: "text-blue-600 hover:underline font-medium" %>
    <% if @event.upcoming? %>
      <%= link_to "Create your own countdown →", new_countdown_path, class: "text-slate-500 hover:text-blue-600 font-medium" %>
    <% else %>
      <%= link_to "Calculate another date →", time_ago_calculator_path, class: "text-slate-500 hover:text-blue-600 font-medium" %>
    <% end %>
  </div>
</div>
