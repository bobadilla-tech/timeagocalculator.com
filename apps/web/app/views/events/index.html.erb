<div class="max-w-7xl mx-auto">
  <nav class="text-sm text-slate-400 mb-6">
    <%= link_to "Home", root_path, class: "hover:text-blue-600" %> /
    <span class="text-slate-600">Event Countdowns</span>
  </nav>

  <%# Search + filters %>
  <div class="mb-6 flex flex-col sm:flex-row gap-3">
    <%= form_with url: events_path, method: :get, local: true, class: "flex gap-2 flex-1" do |f| %>
      <div class="relative flex-1">
        <input type="text" name="q" value="<%= @q %>"
               placeholder="Search events…"
               class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
        <svg class="absolute left-3 top-2.5 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
      </div>
      <%= f.submit "Search", class: "px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 cursor-pointer" %>
    <% end %>
    <div class="flex flex-wrap gap-2 items-center">
      <%= link_to "All", events_path,
          class: "px-3 py-1.5 rounded-full text-sm font-medium #{@category.nil? ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200"}" %>
      <% Event::CATEGORIES.first(8).each do |cat| %>
        <%= link_to cat.titleize, events_path(category: cat),
            class: "px-3 py-1.5 rounded-full text-sm font-medium #{@category == cat ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200"}" %>
      <% end %>
      <%= link_to "More →", "#all-categories",
          class: "px-3 py-1.5 rounded-full text-sm font-medium bg-slate-100 text-slate-600 hover:bg-slate-200" %>
    </div>
  </div>

  <% if @filtered %>
    <%# ── FILTERED / SEARCH VIEW ── %>
    <% if @upcoming.any? %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100">
        <% @upcoming.each do |event| %>
          <%= link_to event_path(event.slug), class: "flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors" do %>
            <% if event.image_url.present? %>
              <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-12 h-12 rounded-lg object-cover shrink-0">
            <% else %>
              <div class="w-12 h-12 rounded-lg bg-linear-to-br from-blue-100 to-blue-200 flex items-center justify-center shrink-0 text-xl">
                <%= category_emoji(event.category) %>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-slate-800 truncate"><%= event.title %></p>
              <p class="text-sm text-slate-500"><%= event.starts_at.strftime("%b %-d, %Y") %></p>
            </div>
            <% days = event.days_until %>
            <span class="shrink-0 <%= days == 0 ? "bg-green-500" : "bg-blue-600" %> text-white text-xs font-bold px-2 py-1 rounded">
              <%= days == 0 ? "Today" : "#{days}d" %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 text-slate-400">
        <p class="text-lg">No events found.</p>
        <%= link_to "Clear filters", events_path, class: "text-blue-600 hover:underline mt-2 inline-block" %>
      </div>
    <% end %>

  <% else %>
    <%# ── HOMEPAGE VIEW ── %>

    <%# Hero + Coming Up Next %>
    <div class="flex gap-4 mb-8" style="min-height:300px">

      <%# Featured hero card %>
      <% if @featured %>
        <div class="flex-2 rounded-2xl overflow-hidden flex min-h-0">
          <%# Image half %>
          <% if @featured.image_url.present? %>
            <div class="flex-[1.2] relative overflow-hidden">
              <img src="<%= @featured.image_url %>" alt="<%= @featured.title %>" class="w-full h-full object-cover">
            </div>
          <% end %>
          <%# Info panel %>
          <div class="<%= @featured.image_url.present? ? "flex-1" : "flex-1" %> bg-[#1b2d5e] p-6 flex flex-col justify-between">
            <div>
              <% if @featured.category.present? %>
                <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider"><%= @featured.category.titleize %></span>
              <% end %>
              <h2 class="text-white text-2xl font-bold mt-1 mb-2 leading-tight"><%= @featured.title %></h2>
              <p class="text-blue-200 text-sm"><%= @featured.starts_at.strftime("%A, %B %-d, %Y") %></p>
            </div>
            <div>
              <% days = @featured.days_until %>
              <div class="text-white font-black leading-none mb-5">
                <% if days == 0 %>
                  <span class="text-5xl">It's</span><br>
                  <span class="text-5xl">Today!</span>
                <% else %>
                  <span class="text-6xl"><%= days %></span>
                  <span class="text-2xl font-semibold ml-1">days away</span>
                <% end %>
              </div>
              <%= link_to "Open countdown →", event_path(@featured.slug),
                  class: "inline-block border border-white/60 text-white text-sm px-4 py-2 rounded-full hover:bg-white hover:text-blue-900 transition-colors" %>
            </div>
          </div>
        </div>
      <% end %>

      <%# Coming Up Next sidebar %>
      <% if @coming_up&.any? %>
        <div class="w-72 shrink-0 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col overflow-hidden">
          <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100 shrink-0">
            <span class="text-xs font-bold text-slate-500 tracking-widest uppercase">Coming Up Next</span>
            <%= link_to "View all →", events_path, class: "text-blue-600 text-xs font-medium hover:underline" %>
          </div>
          <div class="flex-1 overflow-y-auto divide-y divide-slate-50">
            <% @coming_up.each do |event| %>
              <%= link_to event_path(event.slug), class: "flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors" do %>
                <% if event.image_url.present? %>
                  <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-10 h-10 rounded-lg object-cover shrink-0">
                <% else %>
                  <div class="w-10 h-10 rounded-lg bg-linear-to-br from-blue-50 to-blue-100 flex items-center justify-center shrink-0 text-lg">
                    <%= category_emoji(event.category) %>
                  </div>
                <% end %>
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-slate-800 text-sm truncate leading-tight"><%= event.title %></p>
                  <p class="text-xs text-slate-500 mt-0.5"><%= event.starts_at.strftime("%b %-d, %Y") %></p>
                </div>
                <% days = event.days_until %>
                <span class="shrink-0 text-xs font-bold px-2 py-0.5 rounded <%= days == 0 ? "bg-green-500 text-white" : "bg-blue-600 text-white" %>">
                  <%= days == 0 ? "Today" : "#{days}d" %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Annual Highlights %>
    <% if @highlights&.any? %>
      <div class="mb-8">
        <h2 class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3">Annual Highlights</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <% @highlights.each do |event| %>
            <%= link_to event_path(event.slug), class: "relative rounded-2xl overflow-hidden block group", style: "aspect-ratio: 4/3" do %>
              <% if event.image_url.present? %>
                <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% else %>
                <div class="w-full h-full bg-linear-to-br from-slate-700 to-slate-900 flex items-center justify-center">
                  <span class="text-6xl"><%= category_emoji(event.category) %></span>
                </div>
              <% end %>
              <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent"></div>
              <div class="absolute inset-3">
                <span class="text-2xl"><%= category_emoji(event.category) %></span>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-between gap-2">
                <div class="min-w-0">
                  <p class="text-white font-bold text-sm leading-tight truncate"><%= event.title %></p>
                  <p class="text-white/60 text-xs mt-0.5"><%= event.starts_at.strftime("%b %-d, %Y") %></p>
                </div>
                <% days = event.days_until %>
                <span class="shrink-0 text-white text-base font-black leading-none">
                  <%= days %><span class="text-white/60 text-xs font-normal">d</span>
                </span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# All upcoming events %>
    <% if @upcoming&.any? %>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xs font-bold text-slate-500 tracking-widest uppercase">All Upcoming Events</h2>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100 mb-8">
        <% @upcoming.each do |event| %>
          <%= link_to event_path(event.slug), class: "flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors" do %>
            <% if event.image_url.present? %>
              <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-12 h-12 rounded-lg object-cover shrink-0">
            <% else %>
              <div class="w-12 h-12 rounded-lg bg-linear-to-br from-blue-50 to-blue-100 flex items-center justify-center shrink-0 text-xl">
                <%= category_emoji(event.category) %>
              </div>
            <% end %>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-slate-800 truncate"><%= event.title %></p>
              <p class="text-sm text-slate-500">
                <%= event.starts_at.strftime("%b %-d, %Y") %>
                <% if event.country_codes.present? && event.country_codes.length == 1 %>
                  &bull; <%= Events::CountryUtils.country_name(event.country_codes.first) %>
                <% end %>
              </p>
            </div>
            <% days = event.days_until %>
            <span class="shrink-0 <%= days == 0 ? "bg-green-500" : "bg-blue-600" %> text-white text-xs font-bold px-2 py-1 rounded">
              <%= days == 0 ? "Today" : "#{days}d" %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% end %>

  <div class="flex items-center justify-between border-t border-slate-100 pt-6">
    <p class="text-sm text-slate-500">Looking for past events?</p>
    <%= link_to "Browse historical events →", historical_events_path, class: "text-blue-600 hover:underline text-sm font-medium" %>
  </div>
</div>
