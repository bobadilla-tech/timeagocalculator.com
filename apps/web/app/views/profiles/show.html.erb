<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900">@<%= @profile_user.username %></h1>
    <p class="text-slate-500 mt-1">Shared countdowns</p>
    <% if Current.user&.id == @profile_user.id %>
      <p class="mt-3 text-sm text-slate-500">
        This is your public profile.
        <%= link_to "Manage countdowns →", dashboard_path, class: "text-blue-600 hover:underline" %>
      </p>
    <% end %>
  </div>

  <% if @countdowns.empty? %>
    <div class="text-center py-20 text-slate-400">
      <p class="text-lg mb-2">No published countdowns yet.</p>
      <% if Current.user&.id == @profile_user.id %>
        <p class="text-sm">
          Go to your
          <%= link_to "dashboard", dashboard_path, class: "text-blue-600 hover:underline" %>
          and click Publish on a countdown to feature it here.
        </p>
      <% end %>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% @countdowns.each do |cd| %>
        <%
          result = cd.time_until
          label  = result.is_past ? "#{result.human} ago" : "in #{result.human}"
        %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between gap-2 mb-3">
            <h2 class="font-semibold text-slate-900 text-lg leading-snug">
              <%= link_to cd.title, shared_countdown_path(cd.token), class: "hover:text-blue-600" %>
            </h2>
            <% if cd.protected? %>
              <span class="shrink-0 text-xs font-medium bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Protected</span>
            <% end %>
          </div>

          <p class="text-sm text-blue-600 font-medium mb-2"><%= label %></p>
          <p class="text-xs text-slate-400"><%= cd.target_date.strftime("%B %-d, %Y") %></p>

          <% if cd.description.present? %>
            <p class="mt-3 text-sm text-slate-500 line-clamp-2"><%= cd.description %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
