<div class="max-w-2xl mx-auto">
  <nav class="text-sm text-slate-400 mb-6">
    <%= link_to "Home", root_path, class: "hover:text-blue-600" %> /
    <span class="text-slate-600"><%= @page.title %></span>
  </nav>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-600 mb-3">Coming soon</p>
    <h1 class="text-3xl font-bold text-slate-900 mb-3"><%= @page.title %></h1>
    <p class="text-lg text-slate-600 leading-relaxed"><%= @page.description %></p>

    <div class="mt-8 rounded-xl bg-slate-50 border border-slate-200 p-5">
      <h2 class="text-base font-semibold text-slate-800 mb-2">Current status</h2>
      <p class="text-slate-600"><%= @page.status %></p>
    </div>

    <div class="mt-8">
      <%= link_to "Back to calculators", root_path, class: "inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
    
    <% if controller.action_name == 'feedback' %>
      <div class="mt-8">
        <h2 class="text-lg font-semibold mb-3">Send feedback</h2>
        <%= form_with url: feedback_path, method: :post, local: true do |f| %>
          <div class="space-y-3">
            <div>
              <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
              <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-slate-200" %>
            </div>
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
              <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-slate-200" %>
            </div>
            <div>
              <%= f.label :message, class: "block text-sm font-medium text-slate-700" %>
              <%= f.text_area :message, rows: 5, class: "mt-1 block w-full rounded-md border-slate-200" %>
            </div>
            <div>
              <%= f.submit "Send feedback", class: "inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if controller.action_name == 'report_a_bug' %>
      <div class="mt-8">
        <h2 class="text-lg font-semibold mb-3">Report a bug</h2>
        <%= form_with url: report_a_bug_path, method: :post, local: true do |f| %>
          <div class="space-y-3">
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
              <%= f.email_field :email, class: "mt-1 block w-full rounded-md border-slate-200" %>
            </div>
            <div>
              <%= f.label :message, "Describe the bug", class: "block text-sm font-medium text-slate-700" %>
              <%= f.text_area :message, rows: 6, class: "mt-1 block w-full rounded-md border-slate-200" %>
            </div>
            <div>
              <%= f.submit "Submit bug report", class: "inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
