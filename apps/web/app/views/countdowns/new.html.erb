<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">Create a Countdown</h1>
  <p class="text-slate-500 mb-8">Pick a date, give it a name, and get a shareable link instantly.</p>

  <%= form_with model: @countdown, url: countdowns_path,
        data: { controller: "countdown-form" } do |f| %>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-5">

      <%# Title %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Title</label>
        <%= f.text_field :title,
              placeholder: "My Wedding, Launch Day, Summer Holiday…",
              class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 #{"border-red-400" if @countdown.errors[:title].any?}" %>
        <% if @countdown.errors[:title].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @countdown.errors[:title].first %></p>
        <% end %>
      </div>

      <%# Target date %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Target date & time</label>
        <%= f.datetime_local_field :target_date,
              min: Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 #{"border-red-400" if @countdown.errors[:target_date].any?}" %>
        <% if @countdown.errors[:target_date].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @countdown.errors[:target_date].first %></p>
        <% end %>
      </div>

      <%# Description %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">
          Description <span class="text-slate-400 font-normal">(optional)</span>
        </label>
        <%= f.text_area :description,
              rows: 3,
              placeholder: "A short note about this countdown…",
              class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%# Privacy toggle %>
      <div class="flex items-center gap-3">
        <%= f.check_box :is_public,
              checked: @countdown.is_public?,
              class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500",
              data: {
                action: "change->countdown-form#togglePassword",
                "countdown-form-target": "isPublicCheckbox"
              } %>
        <label class="text-sm text-slate-700">
          Public — anyone with the link can view
        </label>
      </div>

      <%# Password fields — hidden when public %>
      <div data-countdown-form-target="passwordFields"
           class="space-y-4 <%= @countdown.is_public? ? "hidden" : "" %>">
        <div class="border-t border-slate-100 pt-4">
          <p class="text-sm text-slate-500 mb-4">Set a password to protect this countdown.</p>

          <div class="space-y-3">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
              <%= f.password_field :password,
                    class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 #{"border-red-400" if @countdown.errors[:password].any?}" %>
              <% if @countdown.errors[:password].any? %>
                <p class="mt-1 text-sm text-red-600"><%= @countdown.errors[:password].first %></p>
              <% end %>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1">Confirm password</label>
              <%= f.password_field :password_confirmation,
                    class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            </div>
          </div>
        </div>
      </div>

      <%= f.submit "Create countdown →",
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg cursor-pointer transition-colors" %>
    </div>
  <% end %>
</div>
