<div class="max-w-2xl mx-auto">
  <div class="mb-2 flex items-center gap-2">
    <% unless @countdown.is_public? %>
      <span class="text-xs font-medium bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Private</span>
    <% end %>
  </div>

  <h1 class="text-3xl font-bold text-slate-900 mb-1"><%= @countdown.title %></h1>
  <p class="text-slate-400 text-sm mb-8">
    Counting down to <%= @countdown.target_date.strftime("%B %-d, %Y at %l:%M %p") %>
  </p>

  <% if @result&.is_past %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 text-center">
      <p class="text-2xl font-bold text-slate-700">This countdown has ended.</p>
      <p class="text-slate-400 mt-2">The date has passed.</p>
    </div>
  <% else %>
    <%= render "shared/result_card" do %>
      <%= render "shared/countdown_display",
            result: @result,
            label: "Live countdown to #{@countdown.title}" %>
    <% end %>
  <% end %>

  <% if @countdown.description.present? %>
    <div class="mt-6 bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <p class="text-slate-600"><%= @countdown.description %></p>
    </div>
  <% end %>

  <%# Share URL copy button %>
  <div class="mt-8 bg-slate-50 rounded-2xl border border-slate-200 p-5"
       data-controller="clipboard"
       data-clipboard-text-value="<%= shared_countdown_url(@countdown.token) %>">
    <p class="text-sm font-medium text-slate-700 mb-3">Share this countdown</p>
    <div class="flex gap-3 items-center">
      <input type="text"
             readonly
             value="<%= shared_countdown_url(@countdown.token) %>"
             class="flex-1 bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-600 focus:outline-none" />
      <button data-clipboard-target="button"
              data-action="click->clipboard#copy"
              class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
        Copy link
      </button>
    </div>
  </div>

  <div class="mt-8">
    <%= link_to "Create your own countdown →", new_countdown_path,
          class: "text-blue-600 hover:underline font-medium" %>
  </div>
</div>
