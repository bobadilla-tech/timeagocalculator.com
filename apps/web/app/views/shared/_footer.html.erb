<% footer_link_class = "text-slate-300 hover:text-white transition-colors" %>
<% footer_placeholder_class = "text-slate-400 hover:text-white transition-colors" %>

<footer class="mt-16 bg-slate-900 text-slate-300">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <section>
        <h2 class="text-white text-lg font-bold mb-4">Date Tools</h2>
        <ul class="space-y-2">
          <li><%= link_to "How Long Ago", time_ago_calculator_path, class: footer_link_class %></li>
          <li><%= link_to "Days Between", date_difference_calculator_path, class: footer_link_class %></li>
          <li><%= link_to "Date Calculator", date_calculator_path, class: footer_link_class %></li>
          <li><%= link_to "Day of the Week", day_of_the_week_path, class: footer_link_class %></li>
          <li><%= link_to "Recurring Date Finder", recurring_date_finder_path, class: footer_link_class %></li>
          <li><%= link_to "Event Countdowns", events_path, class: footer_link_class %></li>
          <li><%= link_to "Create Countdown", new_countdown_path, class: footer_link_class %></li>
        <%= link_to "Buy Me a Coffee", "https://www.buymeacoffee.com/", class: footer_link_class, target: "_blank", rel: "noopener" %>
        </ul>
      </section>

      <section>
        <h2 class="text-white text-lg font-bold mb-4">Calculators</h2>
            <li><%= link_to "Facebook", "https://facebook.com/", class: footer_link_class, target: "_blank", rel: "noopener" %></li>
            <li><%= link_to "Twitter", "https://twitter.com/", class: footer_link_class, target: "_blank", rel: "noopener" %></li>
          <li><%= link_to "Business Days", business_days_calculator_path, class: footer_link_class %></li>
          <li><%= link_to "Week Number", week_number_path, class: footer_link_class %></li>
          <li><%= link_to "Anniversary Calculator", anniversary_calculator_path, class: footer_link_class %></li>
        </ul>
      </section>

      <section>
        <h2 class="text-white text-lg font-bold mb-4">About</h2>
        <ul class="space-y-2">
          <li><%= link_to "Privacy Policy", privacy_policy_path, class: footer_link_class %></li>
          <li><%= link_to "Terms of Service", terms_of_service_path, class: footer_link_class %></li>
          <li><%= link_to "Contact", contact_path, class: footer_link_class %></li>
          <li><%= link_to "FAQs", faqs_path, class: footer_link_class %></li>
        </ul>
      </section>

      <section class="space-y-8">
        <div>
          <h2 class="text-white text-lg font-bold mb-4">Feedback</h2>
          <ul class="space-y-2">
            <li><%= link_to "Give Feedback", feedback_path, class: footer_link_class %></li>
            <li><%= link_to "Report a Bug", report_a_bug_path, class: footer_link_class %></li>
          </ul>
        </div>

        <div>
          <h2 class="text-white text-lg font-bold mb-4">Support Us</h2>
          <%= link_to "Buy Me a Coffee", "https://www.buymeacoffee.com/", class: footer_placeholder_class, target: "_blank", rel: "noopener" %>
          <p class="mt-3 text-sm text-slate-400">Help keep our calculators free.</p>
        </div>

        <div>
          <h2 class="text-white text-lg font-bold mb-4">Follow Us</h2>
          <ul class="space-y-2">
            <li><%= link_to "Facebook", "https://facebook.com/", class: footer_placeholder_class, target: "_blank", rel: "noopener" %></li>
            <li><%= link_to "Twitter", "https://twitter.com/", class: footer_placeholder_class, target: "_blank", rel: "noopener" %></li>
          </ul>
        </div>
      </section>
    </div>

    <div class="mt-12 border-t border-slate-700 pt-6 text-center text-sm text-slate-400">
      <p>&copy; 2025 <%= link_to "Bobadilla Technologies", "http://bobadilla.tech/", class: "font-medium text-slate-300 hover:text-white", target: "_blank", rel: "noopener" %>. All rights reserved.</p>
    </div>
  </div>
</footer>
