<%# Hero banner — full container width, breaks out of layout padding %>
<div class="bg-[#1b2d5e] -mx-4 -mt-10 px-4 pt-14 pb-14 mb-12 text-center">
  <h1 class="text-white text-4xl sm:text-5xl font-black mb-3 leading-tight">
    Countdown to anything.<br class="hidden sm:block"> Calculate any date.
  </h1>
  <p class="text-blue-200 text-base sm:text-lg mb-10 max-w-xl mx-auto">
    Calculate the exact time between any two dates instantly. Find out how many days,
    weeks, months, and years since a past date or until a future event.
  </p>

  <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-3xl mx-auto">

    <%# Check a date %>
    <div class="bg-white/10 backdrop-blur rounded-2xl p-5 flex-1 text-left"
         data-controller="date-redirect">
      <p class="text-blue-200 text-xs font-bold uppercase tracking-widest mb-3">Check a Date</p>
      <p class="text-blue-300 text-xs mb-3">Past or future — any date works</p>
      <div class="flex gap-2">
        <input type="date"
               data-date-redirect-target="date"
               class="flex-1 rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
        <button type="button"
                data-action="click->date-redirect#go"
                class="bg-blue-500 hover:bg-blue-400 text-white font-bold px-5 py-2.5 rounded-xl cursor-pointer text-sm transition-colors shrink-0">
          GO
        </button>
      </div>
    </div>

    <%# Compare two dates %>
    <div class="bg-white/10 backdrop-blur rounded-2xl p-5 flex-1 text-left">
      <p class="text-blue-200 text-xs font-bold uppercase tracking-widest mb-3">Compare Two Dates</p>
      <%= form_with url: date_difference_calculator_path, method: :get, local: true do |f| %>
        <div class="flex gap-2 items-end">
          <div class="flex-1">
            <span class="text-blue-300 text-xs block mb-1 font-medium">From</span>
            <%= f.date_field :from,
                  class: "w-full rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
          </div>
          <div class="flex-1">
            <span class="text-blue-300 text-xs block mb-1 font-medium">To</span>
            <%= f.date_field :to,
                  class: "w-full rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
          </div>
          <%= f.submit "GO", class: "bg-blue-500 hover:bg-blue-400 text-white font-bold px-5 py-2.5 rounded-xl cursor-pointer text-sm transition-colors shrink-0 self-end" %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<%# Quick Calculators %>
<div class="mb-12">
  <h2 class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-4">Quick Calculators</h2>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <% [
      { emoji: "🎂", title: "Age Calculator",          sub: "Your exact age",              path: age_calculator_path },
      { emoji: "💼", title: "Business Days",            sub: "Working days between dates",  path: business_days_calculator_path },
      { emoji: "📅", title: "Day of the Week",          sub: "What day was that?",          path: day_of_the_week_path },
      { emoji: "🗓️", title: "Date Calculator",          sub: "Add or subtract days",        path: date_calculator_path },
    ].each do |card| %>
      <%= link_to card[:path], class: "bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col items-center text-center hover:shadow-md hover:border-blue-200 transition-all group" do %>
        <span class="text-4xl mb-3"><%= card[:emoji] %></span>
        <p class="font-semibold text-slate-800 text-sm group-hover:text-blue-700"><%= card[:title] %></p>
        <p class="text-xs text-slate-400 mt-0.5"><%= card[:sub] %></p>
        <span class="mt-3 text-xs font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">Calculate</span>
      <% end %>
    <% end %>
  </div>
</div>

<%# Event Countdown Section %>
<% if @featured || @coming_up&.any? %>

  <%# Hero + Coming Up Next %>
  <div class="flex gap-4 mb-8" style="min-height:300px">

    <%# Featured hero card %>
    <% if @featured %>
      <div class="flex-2 rounded-2xl overflow-hidden flex min-h-0">
        <% if @featured.image_url.present? %>
          <div class="flex-[1.2] relative overflow-hidden">
            <img src="<%= @featured.image_url %>" alt="<%= @featured.title %>" class="w-full h-full object-cover">
          </div>
        <% end %>
        <div class="flex-1 bg-[#1b2d5e] p-6 flex flex-col justify-between">
          <div>
            <% if @featured.category.present? %>
              <span class="text-xs font-semibold text-blue-300 uppercase tracking-wider"><%= @featured.category.titleize %></span>
            <% end %>
            <h2 class="text-white text-2xl font-bold mt-1 mb-2 leading-tight"><%= @featured.title %></h2>
            <p class="text-blue-200 text-sm"><%= @featured.starts_at.strftime("%A, %B %-d, %Y") %></p>
          </div>
          <div>
            <% days = @featured.days_until %>
            <div class="text-white font-black leading-none mb-5">
              <% if days == 0 %>
                <span class="text-5xl">It's</span><br>
                <span class="text-5xl">Today!</span>
              <% else %>
                <span class="text-6xl"><%= days %></span>
                <span class="text-2xl font-semibold ml-1">days away</span>
              <% end %>
            </div>
            <%= link_to "Open countdown →", event_path(@featured.slug),
                class: "inline-block border border-white/60 text-white text-sm px-4 py-2 rounded-full hover:bg-white hover:text-blue-900 transition-colors" %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Coming Up Next sidebar %>
    <% if @coming_up&.any? %>
      <div class="w-72 shrink-0 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100 shrink-0">
          <span class="text-xs font-bold text-slate-500 tracking-widest uppercase">Coming Up Next</span>
          <%= link_to "View all →", events_path, class: "text-blue-600 text-xs font-medium hover:underline" %>
        </div>
        <div class="flex-1 overflow-y-auto divide-y divide-slate-50">
          <% @coming_up.each do |event| %>
            <%= link_to event_path(event.slug), class: "flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 transition-colors" do %>
              <% if event.image_url.present? %>
                <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-10 h-10 rounded-lg object-cover shrink-0">
              <% else %>
                <div class="w-10 h-10 rounded-lg bg-linear-to-br from-blue-50 to-blue-100 flex items-center justify-center shrink-0 text-lg">
                  <%= category_emoji(event.category) %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-slate-800 text-sm truncate leading-tight"><%= event.title %></p>
                <p class="text-xs text-slate-500 mt-0.5"><%= event.starts_at.strftime("%b %-d, %Y") %></p>
              </div>
              <% days = event.days_until %>
              <span class="shrink-0 text-xs font-bold px-2 py-0.5 rounded <%= days == 0 ? "bg-green-500 text-white" : "bg-blue-600 text-white" %>">
                <%= days == 0 ? "Today" : "#{days}d" %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Annual Highlights %>
  <% if @highlights&.any? %>
    <div class="mb-8">
      <h2 class="text-xs font-bold text-slate-500 tracking-widest uppercase mb-3">Annual Highlights</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <% @highlights.each do |event| %>
          <%= link_to event_path(event.slug), class: "relative rounded-2xl overflow-hidden block group", style: "aspect-ratio: 4/3" do %>
            <% if event.image_url.present? %>
              <img src="<%= event.image_url %>" alt="<%= event.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            <% else %>
              <div class="w-full h-full bg-linear-to-br from-slate-700 to-slate-900 flex items-center justify-center">
                <span class="text-6xl"><%= category_emoji(event.category) %></span>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute inset-3">
              <span class="text-2xl"><%= category_emoji(event.category) %></span>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-between gap-2">
              <div class="min-w-0">
                <p class="text-white font-bold text-sm leading-tight truncate"><%= event.title %></p>
                <p class="text-white/60 text-xs mt-0.5"><%= event.starts_at.strftime("%b %-d, %Y") %></p>
              </div>
              <% days = event.days_until %>
              <span class="shrink-0 text-white text-base font-black leading-none">
                <%= days %><span class="text-white/60 text-xs font-normal">d</span>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="text-center mb-4">
    <%= link_to "View all event countdowns →", events_path,
        class: "text-sm font-medium text-blue-600 hover:underline" %>
  </div>

<% end %>
