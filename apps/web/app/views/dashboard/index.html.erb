<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Dashboard</h1>
      <p class="text-slate-500 mt-1"><%= Current.user.email_address %></p>
    </div>
    <%= link_to "New countdown +", new_countdown_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition-colors" %>
  </div>

  <%# Tabs %>
  <div data-controller="dashboard-tab">
  <div class="border-b border-slate-200 mb-6">
    <nav class="-mb-px flex gap-6 text-sm font-medium">
      <a href="#my-countdowns"
         class="border-b-2 border-blue-600 text-blue-600 pb-3 px-1"
         data-dashboard-tab-target="tab"
         data-tab="my-countdowns">
        My Countdowns (<%= @my_countdowns.size %>)
      </a>
      <a href="#favorites"
         class="border-b-2 border-transparent text-slate-500 hover:text-slate-700 pb-3 px-1"
         data-dashboard-tab-target="tab"
         data-tab="favorites">
        Favorites (<%= @favorited.size %>)
      </a>
    </nav>
  </div>

  <%# My Countdowns panel %>
  <div id="my-countdowns" data-dashboard-tab-target="panel">
    <% if @my_countdowns.empty? %>
      <div class="text-center py-16 text-slate-400">
        <p class="text-lg mb-4">No countdowns yet.</p>
        <%= link_to "Create your first countdown →", new_countdown_path,
              class: "text-blue-600 hover:underline font-medium" %>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @my_countdowns.each do |cd| %>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex items-center gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <% unless cd.is_public? %>
                  <span class="text-xs font-medium bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Private</span>
                <% end %>
                <% if cd.locked? %>
                  <span class="text-xs font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">Locked</span>
                <% end %>
                <span class="text-xs text-slate-400">
                  ♥ <%= cd.favorites_count %>
                </span>
              </div>
              <p class="font-semibold text-slate-900 truncate">
                <%= link_to cd.title, shared_countdown_path(cd.token), class: "hover:text-blue-600" %>
              </p>
              <p class="text-xs text-slate-400 mt-0.5">
                <%= cd.target_date.strftime("%B %-d, %Y") %>
              </p>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <% unless cd.locked? %>
                <%= link_to "Edit", edit_countdown_path(cd.token),
                      class: "text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-1.5 rounded-lg transition-colors" %>
              <% end %>

              <%= button_to cd.locked? ? "Unlock" : "Lock",
                    toggle_lock_countdown_path(cd.token),
                    method: :patch,
                    class: "text-xs #{cd.locked? ? "bg-green-100 text-green-700 hover:bg-green-200" : "bg-amber-100 text-amber-700 hover:bg-amber-200"} font-medium px-3 py-1.5 rounded-lg transition-colors cursor-pointer" %>

              <%= button_to "Delete", shared_countdown_path(cd.token),
                    method: :delete,
                    form: { data: { turbo_confirm: "Delete \"#{cd.title}\"? This cannot be undone." } },
                    class: "text-xs bg-red-100 hover:bg-red-200 text-red-700 font-medium px-3 py-1.5 rounded-lg transition-colors cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @pagy_mine.pages > 1 %>
        <div class="mt-6 flex justify-center">
          <%== @pagy_mine.series_nav %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Favorites panel %>
  <div id="favorites" data-dashboard-tab-target="panel" class="hidden">
    <% if @favorited.empty? %>
      <div class="text-center py-16 text-slate-400">
        <p class="text-lg mb-2">No favorites yet.</p>
        <p class="text-sm">Heart a public countdown to save it here.</p>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @favorited.each do |cd| %>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex items-center gap-4">
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-slate-900 truncate">
                <%= link_to cd.title, shared_countdown_path(cd.token), class: "hover:text-blue-600" %>
              </p>
              <p class="text-xs text-slate-400 mt-0.5">
                <%= cd.target_date.strftime("%B %-d, %Y") %>
                <% if cd.user.present? && !cd.owned_by?(Current.user) %>
                  · by <%= cd.user.email_address %>
                <% end %>
              </p>
            </div>

            <div class="shrink-0">
              <%= button_to "♥ Unfavorite", unfavorite_countdown_path(cd.token),
                    method: :delete,
                    class: "text-xs bg-red-100 hover:bg-red-200 text-red-700 font-medium px-3 py-1.5 rounded-lg transition-colors cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>

      <% if @pagy_fav.pages > 1 %>
        <div class="mt-6 flex justify-center">
          <%== @pagy_fav.series_nav %>
        </div>
      <% end %>
    <% end %>
  </div>

  </div><%# /dashboard-tab controller %>
</div>
