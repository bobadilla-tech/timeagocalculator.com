<%= render "shared/structured_data", schema: @schema %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">Date Difference Calculator</h1>
  <p class="text-slate-500 mb-8">Calculate the number of days, weeks, months and business days between two dates.</p>

  <%= form_with url: date_difference_calculator_path, method: :get, data: { controller: "date-diff" } do |f| %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">From date</label>
          <%= f.date_field :from,
                value: params[:from],
                class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500",
                data: { "date-diff-target": "from" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">To date</label>
          <%= f.date_field :to,
                value: params[:to] || Date.today,
                class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500",
                data: { "date-diff-target": "to" } %>
        </div>
      </div>

      <% if @error %>
        <p class="mt-3 text-sm text-red-600"><%= @error %></p>
      <% end %>

      <%= f.submit "Calculate Difference", class: "mt-4 w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg cursor-pointer transition-colors" %>
    </div>
  <% end %>

  <% if @result %>
    <%= render "shared/result_card" do %>
      <p class="text-lg font-semibold text-slate-700 mb-6">
        Between <span class="text-blue-600"><%= @result.from.strftime("%B %-d, %Y") %></span> and
        <span class="text-blue-600"><%= @result.to.strftime("%B %-d, %Y") %></span>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <% [
          [ @result.total_days,    "Total Days"     ],
          [ @result.business_days, "Business Days"  ],
          [ @result.weeks,         "Weeks"          ],
          [ @result.months,        "Months"         ],
          [ @result.years,         "Years"          ]
        ].each do |value, label| %>
          <div class="text-center bg-slate-50 rounded-xl p-4">
            <div class="text-2xl font-bold text-blue-700"><%= number_with_delimiter(value) %></div>
            <div class="text-xs text-slate-500 mt-1"><%= label %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
