<%= render "shared/structured_data", schema: @schema %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">Date Calculator</h1>
  <p class="text-slate-500 mb-8">Enter any date — past or future — to see exactly how long ago it was or how long until it arrives.</p>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6"
       data-controller="date-redirect">
    <label class="block text-sm font-medium text-slate-700 mb-2">Select any date</label>
    <input type="date" data-date-redirect-target="date"
           class="w-full border border-slate-300 rounded-lg px-4 py-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4">
    <% if @error %>
      <p class="mb-3 text-sm text-red-600"><%= @error %></p>
    <% end %>
    <button type="button" data-action="click->date-redirect#go"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg cursor-pointer transition-colors">
      Calculate
    </button>
  </div>

  <div class="mt-12 prose prose-slate max-w-none">
    <h2 class="text-xl font-semibold text-slate-800">How to use</h2>
    <p class="text-slate-600 mt-2">Select any date — past or future — and click Calculate. You'll get an exact breakdown in days, hours, minutes and seconds, plus every common date format.</p>

    <h2 class="text-xl font-semibold text-slate-800 mt-6">Popular historical events</h2>
    <div class="flex flex-wrap gap-3 mt-3">
      <% @featured_events.each do |event| %>
        <%= link_to event.title, event_path(event.slug),
              class: "text-sm bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-slate-700 px-3 py-1.5 rounded-full transition-colors" %>
      <% end %>
      <%= link_to "Browse all historical events →", historical_events_path,
            class: "text-sm bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-full transition-colors" %>
    </div>
  </div>
</div>
