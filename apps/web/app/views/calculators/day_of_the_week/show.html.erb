<div class="flex gap-8 items-start">

  <%# ── Main column ── %>
  <div class="flex-1 min-w-0">

    <h1 class="text-3xl font-bold text-slate-900 mb-1">Day of the Week Calculator</h1>
    <p class="text-slate-500 mb-6">Find out what day of the week any date falls on</p>

    <%# ── Input form ── %>
    <%= form_with url: day_of_the_week_path, method: :get, local: true do |f| %>
      <div class="bg-[#1b2d5e] rounded-2xl p-6 mb-6">
        <p class="text-blue-200 text-xs font-bold uppercase tracking-widest mb-4">Enter a Date</p>
        <div class="flex gap-3">
          <div class="flex-1">
            <label class="block text-blue-200 text-xs mb-1">Year</label>
            <%= f.number_field :year,
                  value: @input_date&.year || @today.year,
                  min: 1, max: 9999, placeholder: "2026",
                  class: "w-full rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
          </div>
          <div class="flex-[1.4]">
            <label class="block text-blue-200 text-xs mb-1">Month</label>
            <%= f.select :month,
                  Date::MONTHNAMES.compact.each_with_index.map { |name, i| [name, i + 1] },
                  { selected: @input_date&.month || @today.month },
                  class: "w-full rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
          </div>
          <div class="flex-1">
            <label class="block text-blue-200 text-xs mb-1">Day</label>
            <%= f.number_field :day,
                  value: @input_date&.day || @today.day,
                  min: 1, max: 31, placeholder: "5",
                  class: "w-full rounded-xl border border-white/20 bg-white px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
          </div>
        </div>
        <% if @error %>
          <p class="text-red-300 text-sm mt-3"><%= @error %></p>
        <% end %>
        <%= f.submit "Find Day of Week",
              class: "mt-4 w-full bg-blue-500 hover:bg-blue-400 text-white font-bold py-3 rounded-xl cursor-pointer text-sm transition-colors" %>
      </div>
    <% end %>

    <%# ── Result ── %>
    <% if @input_date && !@error %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
        <p class="text-sm text-slate-400 font-medium mb-1"><%= @input_date.strftime("%B %-d, %Y") %></p>
        <p class="text-4xl font-black text-slate-900 mb-4">
          <%= @is_past ? "was" : "is" %> a
          <span class="text-blue-600"><%= @day_of_week %></span>
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-black text-slate-800"><%= @day_of_year %></p>
            <p class="text-xs text-slate-500 font-medium mt-1">Day of Year</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-black text-slate-800"><%= @week_number %></p>
            <p class="text-xs text-slate-500 font-medium mt-1">Week Number</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-black text-slate-800">Q<%= @quarter %></p>
            <p class="text-xs text-slate-500 font-medium mt-1">Quarter</p>
          </div>
          <div class="bg-slate-50 rounded-xl p-4 text-center">
            <p class="text-2xl font-black text-slate-800"><%= @days_in_month %></p>
            <p class="text-xs text-slate-500 font-medium mt-1">Days in Month</p>
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-4">
          <%= @input_date.year %> is <%= @is_leap ? "a leap year (366 days)" : "not a leap year (365 days)" %>.
          <%= link_to "See full breakdown →", date_page_path(@input_date.year, @input_date.strftime("%B").downcase, @input_date.day), class: "text-blue-600 hover:underline" %>
        </p>
      </div>
    <% end %>

    <%# ── Popular Lookups ── %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
      <h2 class="font-bold text-slate-800 mb-5">Popular Day of the Week Lookups</h2>

      <div class="mb-5">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">This Week</p>
        <div class="flex flex-wrap gap-2">
          <% @this_week.each do |date| %>
            <%= link_to day_of_the_week_path(year: date.year, month: date.month, day: date.day),
                  class: "px-3 py-1.5 rounded-full border text-sm font-medium transition-colors #{date == @today ? "bg-blue-600 text-white border-blue-600" : "bg-white text-slate-700 border-slate-200 hover:border-blue-400 hover:text-blue-600"}" do %>
              <%= date.strftime("%a, %b %-d") %><%= " ✦" if date == @today %>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="mb-5">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">First of the Month</p>
        <div class="flex flex-wrap gap-2">
          <% @first_of_months.each do |date| %>
            <%= link_to date.strftime("%b %-d, %Y"),
                  day_of_the_week_path(year: date.year, month: date.month, day: date.day),
                  class: "px-3 py-1.5 rounded-full border border-slate-200 bg-white text-slate-700 text-sm font-medium hover:border-blue-400 hover:text-blue-600 transition-colors" %>
          <% end %>
        </div>
      </div>

      <div>
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Notable Upcoming Dates</p>
        <div class="flex flex-wrap gap-2">
          <% @notable_dates.each do |item| %>
            <%= link_to item[:name],
                  day_of_the_week_path(year: item[:date].year, month: item[:date].month, day: item[:date].day),
                  class: "px-3 py-1.5 rounded-full border border-slate-200 bg-white text-slate-700 text-sm font-medium hover:border-blue-400 hover:text-blue-600 transition-colors" %>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Related tools ── %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
        <p class="text-xl mb-2">📅</p>
        <p class="font-semibold text-slate-800 mb-1">Find All Days in a Year</p>
        <p class="text-sm text-slate-500 mb-4">Find all occurrences of a specific day of the week in any year</p>
        <%= link_to "View Tool", week_number_path, class: "inline-block border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 text-sm font-medium px-4 py-1.5 rounded-full transition-colors" %>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
        <p class="text-xl mb-2">🔍</p>
        <p class="font-semibold text-slate-800 mb-1">Find Recurring Dates</p>
        <p class="text-sm text-slate-500 mb-4">Find when a specific date falls on a specific day of the week</p>
        <%= link_to "View Tool", recurring_date_finder_path, class: "inline-block border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 text-sm font-medium px-4 py-1.5 rounded-full transition-colors" %>
      </div>
    </div>

    <%# ── About ── %>
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-6">
      <p class="font-semibold text-slate-800 mb-3">ℹ️ About This Calculator</p>
      <ul class="space-y-1.5 text-sm text-slate-600">
        <li><strong>Historical dates:</strong> Find the day of the week for any date back to the year 1</li>
        <li><strong>Future dates:</strong> Calculate the day of the week for dates up to 9999</li>
        <li><strong>Detailed information:</strong> Get week number, day of year, quarter, and more</li>
        <li><strong>Related dates:</strong> View adjacent dates and same-weekday occurrences</li>
      </ul>
    </div>

    <%# ── Other Date Tools ── %>
    <div>
      <p class="text-xs font-bold text-slate-400 tracking-widest uppercase mb-3">Other Date Tools</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% [
          { emoji: "🎂", title: "Age Calculator",   sub: "Your exact age",              path: age_calculator_path },
          { emoji: "📏", title: "Days Between",      sub: "Days between two dates",      path: date_difference_calculator_path },
          { emoji: "💼", title: "Business Days",     sub: "Working days between dates",  path: business_days_calculator_path },
          { emoji: "🗓️", title: "Date Calculator",   sub: "Add or subtract days",        path: date_calculator_path },
        ].each do |card| %>
          <%= link_to card[:path], class: "bg-white rounded-xl border border-slate-200 shadow-sm p-4 text-center hover:shadow-md hover:border-blue-200 transition-all group" do %>
            <span class="text-3xl block mb-2"><%= card[:emoji] %></span>
            <p class="font-semibold text-slate-800 text-xs group-hover:text-blue-700 leading-tight"><%= card[:title] %></p>
            <p class="text-xs text-slate-400 mt-0.5 leading-tight"><%= card[:sub] %></p>
            <span class="mt-2 inline-block text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">Open</span>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>

  <%# ── Sidebar ── %>
  <aside class="w-72 shrink-0 hidden lg:flex flex-col gap-4">

    <%# Check a Date %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5"
         data-controller="date-redirect">
      <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">🗓️ Check a Date</p>
      <input type="date"
             data-date-redirect-target="date"
             class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 mb-3">
      <button type="button"
              data-action="click->date-redirect#go"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl cursor-pointer text-sm transition-colors">
        GO
      </button>
    </div>

    <%# Days Between %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
      <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">📊 Days Between</p>
      <%= form_with url: date_difference_calculator_path, method: :get, local: true do |f| %>
        <div class="space-y-2 mb-3">
          <div>
            <label class="text-xs text-slate-400 block mb-1">From:</label>
            <%= f.date_field :from, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" %>
          </div>
          <div>
            <label class="text-xs text-slate-400 block mb-1">To:</label>
            <%= f.date_field :to, class: "w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" %>
          </div>
        </div>
        <%= f.submit "CALCULATE", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl cursor-pointer text-sm transition-colors" %>
      <% end %>
    </div>

    <%# Popular Countdowns %>
    <% if @popular_countdowns.any? %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-3">🔥 Popular Countdowns</p>
        <div class="space-y-2">
          <% @popular_countdowns.each do |event| %>
            <%= link_to event_path(event.slug),
                  class: "flex items-center gap-2 py-2 px-3 rounded-xl hover:bg-slate-50 transition-colors group" do %>
              <% if event.image_url.present? %>
                <img src="<%= event.image_url %>" alt="" class="w-8 h-8 rounded-lg object-cover shrink-0">
              <% else %>
                <span class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-base shrink-0"><%= category_emoji(event.category) %></span>
              <% end %>
              <span class="text-sm font-medium text-slate-700 group-hover:text-blue-600 truncate"><%= event.title %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Support %>
    <div class="bg-amber-50 border border-amber-100 rounded-2xl p-5 text-center">
      <p class="text-2xl mb-2">☕</p>
      <p class="font-bold text-slate-800 text-sm mb-1">Love Our Tools?</p>
      <p class="text-xs text-slate-500 mb-3">Help keep our calculators free by supporting us</p>
      <%= link_to "☕ Buy Me a Coffee", "https://www.buymeacoffee.com/",
            target: "_blank", rel: "noopener",
            class: "inline-block bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-sm px-4 py-2 rounded-xl transition-colors" %>
    </div>

  </aside>

</div>
