<%= render "shared/structured_data", schema: @schema %>

<div class="max-w-2xl mx-auto" data-controller="hours-ago" data-hours-ago-now-value="<%= @now.iso8601 %>">
  <h1 class="text-3xl font-bold text-slate-900 mb-2">Hours Ago Calculator</h1>
  <p class="text-slate-500 mb-8">Enter an initial time (or use now) and the number of hours and minutes ago to calculate.</p>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <label class="block text-sm font-medium text-slate-700 mb-2">Initial date</label>
    <div class="flex gap-3 mb-4">
      <input type="date" data-hours-ago-target="date" class="border rounded px-3 py-2 w-1/2">
      <input type="time" data-hours-ago-target="time" class="border rounded px-3 py-2 w-1/2">
    </div>

    <label class="block text-sm font-medium text-slate-700 mb-2">Hours Ago</label>
    <div class="flex gap-3 mb-4">
      <input type="number" min="0" value="0" data-hours-ago-target="hours" class="border rounded px-3 py-2 w-1/3">
      <input type="number" min="0" max="59" value="0" data-hours-ago-target="minutes" class="border rounded px-3 py-2 w-1/3">
      <select data-hours-ago-target="format" class="border rounded px-3 py-2 w-1/3">
        <option value="12">12h am/pm</option>
        <option value="24">24 hour</option>
      </select>
    </div>

    <button type="button" data-action="click->hours-ago#calculate" class="bg-blue-600 text-white px-4 py-2 rounded">Calculate</button>

    <div class="mt-6" data-hours-ago-target="result">
      <!-- Result will be injected here -->
    </div>
  </div>

  <div class="mt-12">
    <h2 class="text-xl font-semibold text-slate-800 mb-3">Hours Ago From Now Table</h2>
    <div class="overflow-auto bg-white rounded border p-4" data-hours-ago-target="table">
      <!-- Table populated by JS -->
    </div>
  </div>
</div>
